{
  "name": "mira-spaces",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "dev:beta": "vite --config vite.beta.config.ts",
    "build:beta": "tsc -b && vite build --config vite.beta.config.ts",
    "start": "node dist-server/index.js",
    "build": "npm run build:web && npm run build:api",
    "build:web": "tsc -b && vite build",
    "build:api": "tsc -p tsconfig.server.json",
    "db:auth:generate": "npx auth generate --config server/auth.ts",
    "db:auth:migrate": "npx auth migrate --config server/auth.ts --yes",
    "db:migrate": "tsx server/migrate.ts",
    "admin:grant": "tsx server/grant-admin.ts",
    "storage:import-worker": "tsx server/import-worker-files.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:beta": "playwright test --config playwright.beta.config.ts",
    "test:server": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@sparkjsdev/spark": "^2.1.0",
    "better-auth": "^1.7.2",
    "dotenv": "^17.2.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "0.468.0",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.5",
    "pg": "^8.16.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.8.2",
    "three": "^0.180.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^7.0.1",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.180.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@vitejs/plugin-react": "^4.3.4",
    "caniuse-lite": "^1.0.30001810",
    "concurrently": "^9.2.1",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "typescript": "~5.7.2",
    "tsx": "^4.20.5",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.0.5"
  }
}
